# これを .env.local に写して、鍵を入れて使う。.env.local は git に入れない。
# 値は Supabase の Project Settings > API Keys から取る。

NEXT_PUBLIC_SUPABASE_URL=https://hqjoncbueuadqxkkpdsn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 開発中の認証。既定では npm run dev のとき認証を切ってある。
# 切っている間はサーバーに触らず、記録はこの端末の中だけに貯まる。
# ログインの流れそのものを試したいときだけ 0 にする。
#
# npm run build では NODE_ENV が production になり、この値に関わらず
# 認証は必ず有効になる。Vercel 側に置いても本番が素通しになることはない。
# NEXT_PUBLIC_DEV_NO_AUTH=0
